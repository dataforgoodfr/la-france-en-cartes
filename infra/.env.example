# Copiez ce fichier en infra/.env puis chargez-le avec :
#   set -a; source infra/.env; set +a

# Organisation Clever Cloud (variable tofu clever_organisation)
TF_VAR_clever_organisation=orga_xxx

# Phrase de passe du chiffrement du state (≥ 16 caractères)
TF_VAR_state_passphrase=change_me_16_chars_min

# Accès Cellar, pour le backend S3 du tfstate
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REQUEST_CHECKSUM_CALCULATION=when_required

# Facultatif : surcharge les valeurs par défaut de infra/backend/variables.tf
# TF_VAR_cellar_name=tfstate
# TF_VAR_state_bucket_name=tfstate-bucket-d4g-lfe4
